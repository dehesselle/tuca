        "--snapshot",
        "win2k25",
        "--flavorid",
        "8x16",
        "--ssdgb",
        "50",
        "--password",
        "start123"
      ]
    },
    {
      "name": "W list servers",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.venv/Scripts/tuca.exe",
      "console": "integratedTerminal",
      "args": [
        "servers",
        "list",
      ]
    }
  ]
}
